# Fresca Premier Fresh – static Nuxt site on cPanel (Apache / LiteSpeed)
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Keep links from the old WordPress site working
RewriteRule ^about-us/?$                       /about/    [R=301,L]
RewriteRule ^contact-us/?$                     /contact/  [R=301,L]
RewriteRule ^team-at-fresca-premier-fresh/?$   /team/     [R=301,L]
RewriteRule ^packages/?$                       /products/ [R=301,L]
RewriteRule ^(sample-page|hello-world)/?$      /          [R=301,L]
RewriteRule ^20\d\d/\d\d/\d\d/hello-world/?$   /          [R=301,L]

# Never expose hidden files
RewriteRule (^|/)\.(?!well-known) - [F,L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault              "access plus 1 hour"
ExpiresByType text/html     "access plus 5 minutes"
ExpiresByType image/jpeg    "access plus 30 days"
ExpiresByType image/png     "access plus 30 days"
ExpiresByType image/webp    "access plus 30 days"
ExpiresByType text/css      "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
# Hashed build files never change
<FilesMatch "^_nuxt/">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
